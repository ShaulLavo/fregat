{
  "name": "@fregat/hotkeys",
  "version": "0.0.3",
  "description": "Keyboard shortcut registration, chords, context-aware keymaps, and display formatting for browser and terminal apps.",
  "keywords": [
    "browser",
    "chords",
    "hotkeys",
    "keybindings",
    "keyboard",
    "shortcuts",
    "typescript"
  ],
  "homepage": "https://github.com/ShaulLavo/fregat/tree/main/hotkeys",
  "bugs": {
    "url": "https://github.com/ShaulLavo/fregat/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/fregat.git",
    "directory": "hotkeys/packages/hotkeys"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --format esm --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/store": "^0.11.1"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
