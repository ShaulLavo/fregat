{
  "name": "@singapore-editor/markdown",
  "version": "0.2.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/fregat.git",
    "directory": "editor/packages/markdown"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapore-editor/core": "workspace:*",
    "micromark-util-decode-string": "2.0.1",
    "micromark-util-normalize-identifier": "2.0.1",
    "tree-sitter-md": "github:ShaulLavo/tree-sitter-md#f7263d7f7b1593270b348f007c80eddb3916c761"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
