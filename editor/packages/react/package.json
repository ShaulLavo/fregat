{
  "name": "@singapore-editor/react",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/fregat.git",
    "directory": "editor/packages/react"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapore-editor/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.2",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@singapore-editor/core": "workspace:*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
