{
  "name": "@singapore-editor/scope-lines",
  "version": "0.2.9",
  "description": "Indent guides, sticky headers, and bracket pair colors for the Singapore editor.",
  "keywords": [
    "browser",
    "editor",
    "indent-guides",
    "singapore",
    "sticky-scroll",
    "typescript"
  ],
  "homepage": "https://shaulavo.dev/singapore/docs/reference/api/scope-lines/overview/",
  "bugs": {
    "url": "https://github.com/ShaulLavo/fregat/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/fregat.git",
    "directory": "editor/packages/scope-lines"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/style.css",
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapore-editor/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/browser-playwright": "5.0.2",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
