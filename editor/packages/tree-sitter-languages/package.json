{
  "name": "@singapore-editor/tree-sitter-languages",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/fregat.git",
    "directory": "editor/packages/tree-sitter-languages"
  },
  "files": [
    "README.md",
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "languages:generate": "node scripts/generate.mjs",
    "languages:verify": "node scripts/generate.mjs --check && vitest run",
    "languages:build": "node scripts/build-grammars.mjs",
    "languages:build:sql": "node scripts/build-sql.mjs",
    "languages:build:mdx": "node scripts/build-mdx.mjs"
  },
  "dependencies": {
    "@singapore-editor/tree-sitter": "workspace:*",
    "@tree-sitter-grammars/tree-sitter-lua": "0.4.1",
    "@tree-sitter-grammars/tree-sitter-toml": "0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-css": "0.25.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-html": "0.23.2",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-json": "0.24.8",
    "tree-sitter-md": "github:ShaulLavo/tree-sitter-md#9ca896688749f4043f6ddf7ffc00993cd781e434",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-svelte": "0.11.0",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@singapore-editor/core": "workspace:*",
    "@types/node": "^26.6.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tree-sitter-cli": "0.27.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "web-tree-sitter": "github:ShaulLavo/tree-sitter-x#059451d3c167443643630d471c2c2d61c13b10ff"
  },
  "peerDependencies": {
    "@singapore-editor/core": "workspace:*",
    "@singapore-editor/tree-sitter": "workspace:*"
  }
}
