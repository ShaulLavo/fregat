{
  "name": "@singapore-editor/collab",
  "version": "0.0.1",
  "description": "Runtime-neutral host-ordered collaborative text and a FugueMax reference engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/fregat.git",
    "directory": "editor/packages/collab"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_LICENSES"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "bench": "node bench/engine.mjs",
    "bench:fragmented": "node bench/fragmented.mjs"
  },
  "dependencies": {
    "@singapore-editor/textbuffer": "workspace:*"
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
