{
  "name": "@singapore-editor/textbuffer",
  "version": "0.1.0",
  "description": "Persistent balanced-tree text buffer with snapshots, stable anchors, and line mapping",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js",
      "default": "./dist/debug.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    },
    "./internal/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "bun test/package-smoke.ts",
    "verify": "bun run typecheck && bun run build && bun run test && bun run test:package",
    "bench": "bun bench/run.ts",
    "bench:prepare": "bun bench/prepare.ts",
    "bench:height": "bun bench/height.ts",
    "bench:test": "vitest run --config bench/vitest.config.ts",
    "bench:check": "bun run build && bun run bench:prepare && bun run bench:test",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "bench:profile": "bun bench/profile.ts",
    "bench:profile:check": "bun run build && bun run bench:prepare && node --expose-gc --test bench/profile.spec.ts"
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vitest": "5.0.2"
  },
  "packageManager": "bun@1.4.2"
}
