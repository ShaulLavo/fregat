{
  "name": "@singapore-editor/textbuffer",
  "version": "0.2.6",
  "description": "A persistent piece-table text buffer with snapshots, stable anchors, and line mapping.",
  "keywords": [
    "browser",
    "editor",
    "piece-table",
    "singapore",
    "snapshots",
    "typescript"
  ],
  "homepage": "https://shaulavo.dev/singapore/docs/reference/api/textbuffer/overview/",
  "bugs": {
    "url": "https://github.com/ShaulLavo/fregat/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/fregat.git",
    "directory": "editor/packages/textbuffer"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js",
      "default": "./dist/debug.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    },
    "./internal/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node test/package-smoke.mjs",
    "verify": "bun run typecheck && bun run build && bun run test && bun run test:package",
    "bench": "node bench/run.mjs",
    "bench:prepare": "node bench/prepare.mjs",
    "bench:height": "node bench/height.mjs",
    "bench:test": "vitest run --config bench/vitest.config.mjs",
    "bench:check": "bun run build && bun run bench:prepare && bun run bench:test",
    "lint": "oxlint . --ignore-pattern 'bench/vscode-textbuffer/**'",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "bench:profile": "node bench/profile.mjs",
    "bench:profile:check": "bun run build && bun run bench:prepare && node --expose-gc --test bench/profile.spec.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vitest": "5.0.2"
  },
  "packageManager": "bun@1.4.2"
}
