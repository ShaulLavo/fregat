---
import '../styles/site.css'
const docs = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/docs/start-here/introduction/`
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Singapore browser code editor documentation." />
    <title>Singapore</title>
  </head>
  <body>
    <main class="placeholder-home">
      <h1>Singapore</h1>
      <p>A code editor for the browser.</p>
      <a href={docs}>Read the documentation</a>
      <p><a href="https://shaulavo.dev/singapore/demo/">Open the full demo</a></p>
    </main>
  </body>
</html>
