---
import Manual from '../layouts/Manual.astro'
import { NAV } from '../manual/content'
import Captured from '../manual/Captured.astro'
import { capturedDocument } from '../manual/captured'
const sample = capturedDocument('hero.ts')
const install = capturedDocument('install.sh')
const start = NAV.find((section) => section.label === 'Start here')!
const tagline = 'A code editor for the browser that keeps every version.'
---

<Manual title="Singapore" description={tagline} bodyClass="home">
  <main id="doc" class="home-column" tabindex="-1">
    <h1>{tagline}</h1>
    <p>
      Singapore is a modular code editor component. Each edit makes a new version of a persistent
      piece table, and anchors follow text through edits. Parsing, highlighting and language
      servers run in workers.
    </p>
    <figure class="hero">
      <div class="hero-box src">
        <div class="hero-static paint-article">
          <Captured capture={sample} id="document-paint" />
        </div>
      </div>
      <figcaption>
        <span>This is a Singapore editor, configured for TypeScript. Edit this.</span>
        <span class="hero-mode"></span>
      </figcaption>
    </figure>
    <h2>Install</h2>
    <div class="src install paint-article">
      <Captured capture={install} id="install-paint" />
    </div>
    <p>
      Then follow the <a href={start.pages[1]!.href}>quick start</a>. Every docs page opens in the
      same editor you are installing.
    </p>
    <h2>Start here</h2>
    <ul class="index">
      {
        start.pages.map((page) => (
          <li>
            <a href={page.href}>{page.label}</a>
          </li>
        ))
      }
    </ul>
    <h2>Limits</h2>
    <p>
      The public API is still changing. Rows have fixed height, syntax colours cannot use bold or
      italic, and mobile and touch are outside the current target. There is no published
      editor-level benchmark against Monaco or CodeMirror yet.
    </p>
    <footer>
      MIT licensed. Part of <a href="https://github.com/ShaulLavo/fregat">Fregat</a>, where issues
      and contributions go.
    </footer>
  </main>
  <script>
    import '../manual/home'
  </script>
</Manual>
