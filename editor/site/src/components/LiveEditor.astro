<div class="live-editor not-content" data-singapore-example aria-label="Editable Singapore example">
  <pre>const greeting = "Hello, Singapore"</pre>
</div>
<script>
  import { mountEditor } from '../examples/basic'
  for (const element of document.querySelectorAll<HTMLElement>('[data-singapore-example]')) {
    element.replaceChildren()
    const editor = mountEditor(element)
    window.addEventListener('pagehide', (event) => {
      if (!event.persisted) editor.dispose()
    })
  }
</script>
