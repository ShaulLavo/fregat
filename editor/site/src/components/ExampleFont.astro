<script is:inline>
  // One choice for every example on the page, so static and live paint never use different faces.
  // Examples stay hidden for at most the browser's own optional-font block period while it settles.
  const root = document.documentElement
  root.dataset.exampleFont = 'pending'
  const choose = (font) => {
    if (root.dataset.exampleFont === 'pending') root.dataset.exampleFont = font
  }
  const decide = () => {
    document.fonts.load('14px "JetBrains Mono"').then(
      (faces) => choose(faces.length ? 'mono' : 'fallback'),
      () => choose('fallback'),
    )
    setTimeout(() => choose('fallback'), 100)
  }
  // Wait for the stylesheets that register the @font-face rules, but not for deferred or module
  // scripts, so a stalled script can't keep examples hidden. A stalled stylesheet blocks paint anyway.
  const afterStylesheets = () => {
    const pending = Array.from(document.querySelectorAll('link[rel="stylesheet"]')).filter(
      (link) => !link.sheet,
    )
    if (!pending.length) return decide()
    let left = pending.length
    const settle = () => {
      left -= 1
      if (!left) decide()
    }
    for (const link of pending) {
      link.addEventListener('load', settle, { once: true })
      link.addEventListener('error', settle, { once: true })
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('readystatechange', afterStylesheets, { once: true })
  } else {
    afterStylesheets()
  }
</script>
