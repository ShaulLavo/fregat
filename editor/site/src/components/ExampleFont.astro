<script is:inline>
  // One choice for every example on the page, so static and live paint never use different faces.
  // Examples stay hidden for at most the browser's own optional-font block period while it settles.
  const root = document.documentElement
  root.dataset.exampleFont = 'pending'
  const choose = (font) => {
    if (root.dataset.exampleFont === 'pending') root.dataset.exampleFont = font
  }
  // The @font-face rules are parsed with the stylesheets that follow this script.
  document.addEventListener(
    'DOMContentLoaded',
    () => {
      document.fonts.load('14px "JetBrains Mono"').then(
        (faces) => choose(faces.length ? 'mono' : 'fallback'),
        () => choose('fallback'),
      )
      setTimeout(() => choose('fallback'), 100)
    },
    { once: true },
  )
</script>
