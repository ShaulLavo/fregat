<div class="live-editor not-content" data-singapore-playground aria-label="TypeScript playground">
  <pre is:raw>import { twice } from './math'

twice('two')</pre>
</div>
<script>
  import { mountPlayground } from '../examples/playground'
  for (const element of document.querySelectorAll<HTMLElement>('[data-singapore-playground]')) {
    element.replaceChildren()
    const editor = mountPlayground(element)
    window.addEventListener('pagehide', (event) => {
      if (!event.persisted) editor.dispose()
    })
  }
</script>
