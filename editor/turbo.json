{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".oxfmtrc.json",
    "examples/app/tsconfig.json",
    "global.d.ts",
    "scripts/build-package.ts",
    "tsconfig.json",
    "scripts/workspace-root*"
  ],
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@singapore-editor/core#typecheck": {
      "dependsOn": [
        "build",
        "@singapore-editor/decode#build",
        "@singapore-editor/diff#build",
        "@singapore-editor/find#build",
        "@singapore-editor/gutters#build",
        "@singapore-editor/markdown#build",
        "@singapore-editor/scope-lines#build",
        "@singapore-editor/tree-sitter-languages#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/stress/src/fixtures.ts",
        "$TURBO_ROOT$/bench/compare/fixture.mjs",
        "$TURBO_ROOT$/bench/compare/protocol.mjs",
        "$TURBO_ROOT$/site/src/fonts/jetbrains-mono.woff2",
        "$TURBO_ROOT$/site/src/fonts/source-serif-4.woff2"
      ]
    },
    "@singapore-editor/react#typecheck": {
      "dependsOn": ["^build", "build", "@singapore-editor/tree-sitter-languages#build"]
    },
    "@singapore-editor/tree-sitter#typecheck": {
      "dependsOn": [
        "^build",
        "build",
        "@singapore-editor/markdown#build",
        "@singapore-editor/tree-sitter-languages#build"
      ]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "@singapore-editor/core#test": {
      "dependsOn": [
        "build",
        "@singapore-editor/tree-sitter-languages#build",
        "@singapore-editor/diff#build",
        "@singapore-editor/gutters#build"
      ],
      "cache": false
    },
    "@singapore-editor/highlighting#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser-test-responses.ts"]
    },
    "@singapore-editor/react#test": {
      "dependsOn": ["^build", "build", "@singapore-editor/tree-sitter-languages#build"]
    },
    "@singapore-editor/tree-sitter#test": {
      "dependsOn": [
        "^build",
        "build",
        "@singapore-editor/markdown#build",
        "@singapore-editor/tree-sitter-languages#build"
      ]
    },
    "@singapore-editor/markdown#typecheck": {
      "dependsOn": ["^build", "build", "@singapore-editor/tree-sitter-languages#build"]
    },
    "@singapore-editor/markdown#test": {
      "dependsOn": ["^build", "build", "@singapore-editor/tree-sitter-languages#build"]
    },
    "@singapore-editor/stress#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@singapore-editor/stress#test": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/performance/e034-*.json.gz"]
    },
    "@singapore-editor/collaboration#test:browser": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser-test-responses.ts"],
      "env": ["COLLABORATION_TEST_TURN"],
      "outputs": []
    },
    "@singapore-editor/core#bench:edit-commands": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser-test-responses.ts"]
    },
    "@singapore-editor/highlighting#test:browser": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser-test-responses.ts"]
    },
    "@singapore-editor/highlighting#test:engines": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser-test-responses.ts"]
    },
    "@singapore-editor/typescript-lsp#test:browser": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser-test-responses.ts"]
    },
    "@singapore-editor/tree-sitter#test:browser": {
      "dependsOn": [
        "^build",
        "build",
        "@singapore-editor/markdown#build",
        "@singapore-editor/tree-sitter-languages#build"
      ]
    },
    "@singapore-editor/tree-sitter#test:runtime": {
      "dependsOn": [
        "^build",
        "build",
        "@singapore-editor/markdown#build",
        "@singapore-editor/tree-sitter-languages#build"
      ]
    },
    "singapore-editor-site#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "singapore-editor-site#test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "singapore-editor-site#typecheck": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"]
    },
    "@singapore-editor/collaboration#bench:merge-review": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/mergeUnits.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/edits.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/projection.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/reuse.ts",
        "$TURBO_ROOT$/packages/tree-sitter-languages/languages.json"
      ],
      "outputs": [],
      "cache": false
    },
    "@singapore-editor/collaboration#test:editor": {
      "dependsOn": ["^build", "@singapore-editor/diff#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/editor/src/**",
        "$TURBO_ROOT$/examples/app/src/**"
      ],
      "env": ["COLLABORATION_MEASURE", "COLLABORATION_EVIDENCE_DIR"],
      "outputs": [],
      "cache": false
    },
    "@singapore-editor/collab#test": {
      "dependsOn": ["^build", "build", "@singapore-editor/collaboration#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/collaboration/src/**"],
      "env": ["COLLAB_STRESS", "COLLABORATION_LONG_RUN"]
    },
    "@singapore-editor/collab#typecheck": {
      "dependsOn": ["^build", "build", "@singapore-editor/collaboration#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/collaboration/src/**"]
    },
    "@singapore-editor/collaboration#test": {
      "dependsOn": ["^build", "build", "@singapore-editor/diff#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/app/src/**",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/mergeUnits.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/edits.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/projection.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/reuse.ts",
        "$TURBO_ROOT$/packages/tree-sitter-languages/languages.json"
      ]
    },
    "@singapore-editor/collaboration#typecheck": {
      "dependsOn": ["^build", "build", "@singapore-editor/diff#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/app/src/**",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/mergeUnits.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/edits.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/projection.ts",
        "$TURBO_ROOT$/packages/tree-sitter/src/treeSitter/reuse.ts",
        "$TURBO_ROOT$/packages/tree-sitter-languages/languages.json"
      ]
    },
    "@singapore-editor/core#bench:paint": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser-test-responses.ts"]
    }
  },
  "agentGuidance": false
}
