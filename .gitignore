# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
dist
apps/desktop/build/

# Hutch's generated Electrobun devkit projection (rebuilt by `electrobun prepare`)
# and the scratch it leaves while a dev build runs
apps/desktop/.hutch/
apps/desktop/.cottontail-tmp/

# Debug
npm-debug.log*
# Anchored: the structured log output lives at the repo root. Unanchored, this also
# swallowed new files under any `logs/` directory in the source tree.
/logs/
.evlog/

# Misc
.DS_Store
*.pem
.kiro/
references/
.desloppify/

# Playwright MCP output (screenshots, snapshots, console/network logs)
.playwright-mcp/

# jscpd duplication report
jscpd-report/
.bench-fixtures/

# Compiled native helpers (rebuilt by apps/desktop `build:native`)
apps/desktop/native/build/

# TypeScript incremental build state
tsconfig.tsbuildinfo
*.tsbuildinfo

# Local agent worktrees
.claude/worktrees/

# Screenshots written by the design surface pass (a manual tool, not an assertion).
apps/web/src/**/surface-*.png

# Emitted beside a web build by apps/web/scripts/bundle-stats-plugin.ts
apps/web/bundle-stats.json
apps/web/bundle-report.json

# astro generates this on every build
.astro/

# Python bytecode from scripts/parity
__pycache__/
*.pyc
