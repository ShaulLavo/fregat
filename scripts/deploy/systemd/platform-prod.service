# Rendered by scripts/deploy/mesh.ts. Edit the template, not this file.
[Unit]
Description=Platform production server
After=network-online.target
Wants=network-online.target
# Never give up: a crash loop is paced by the backoff below.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory={{PRODUCTION_ROOT}}
# Consumes an explicit restart approval before promoting; crashes keep the served release.
ExecStartPre=-{{BUN}} {{PRODUCTION_ROOT}}/bin/promote.ts {{PRODUCTION_ROOT}}
ExecStart={{BUN}} {{PRODUCTION_ROOT}}/current/server/index.js
Restart=on-failure
# Restart (exit 75) comes back at once; a crash loop backs off to 10s.
RestartSec=250ms
RestartSteps=5
RestartMaxDelaySec=10s
# 143: Bun's exit on SIGTERM. 75: the server's exit after Restart.
SuccessExitStatus=143 75
RestartForceExitStatus=75
Environment=NODE_ENV=production
Environment=BUN_ENV=production
Environment=FS_HOST=127.0.0.1
Environment=PORT={{PORT}}
Environment=WEB_ROOT={{PRODUCTION_ROOT}}/current/web
Environment=PLATFORM_PRODUCTION_ROOT={{PRODUCTION_ROOT}}
Environment=SERVER_ALLOWED_ORIGINS={{MESH_ORIGIN}},{{TUI_ORIGIN}}
Environment=OBSERVABILITY_DIR={{PRODUCTION_ROOT}}/logs
Environment=PATH={{HOME}}/.local/share/mise/shims:{{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
