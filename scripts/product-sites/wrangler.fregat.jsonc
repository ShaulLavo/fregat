{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "product-sites-fregat",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "fregat.shaulavo.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist/fregat",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
}
