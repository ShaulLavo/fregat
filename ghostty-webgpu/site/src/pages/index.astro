---
import pageCss from '../styles/styles.css?inline'
import fontCss from '../styles/fonts.css?inline'
import firstFrameCss from '../styles/first-frame.css?inline'
import { firstGhostFrame } from '../first-frame.js'

const firstFrame = await firstGhostFrame()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ghostty-webgpu</title>
    <style is:inline set:html={pageCss + fontCss + firstFrameCss}></style>
    <meta
      name="description"
      content="An unofficial Ghostty for the web: libghostty-vt in WebAssembly with a damage-aware WebGPU renderer and a native API. Try it live."
    />
    <script is:inline>
      document.documentElement.style.setProperty('--ghost-device-pixel', `${1 / devicePixelRatio}px`)
    </script>
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/jetbrains-mono-latin-600-normal.woff2" fetchpriority="low" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/jetbrains-mono-latin-400-italic.woff2" fetchpriority="low" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/bricolage-grotesque-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="ghostty-vt.wasm" fetchpriority="low" as="fetch" type="application/wasm" crossorigin />
    <link rel="preload" href="ghost-frames.txt.gz" fetchpriority="low" as="fetch" crossorigin />
  </head>
  <body>
    <header class="masthead">
      <a class="wordmark" href="https://github.com/ShaulLavo/ghostty-webgpu">ghostty-webgpu</a>
      <nav class="links" aria-label="Project links">
        <a href="https://github.com/ShaulLavo/ghostty-webgpu">GitHub</a>
        <a href="https://www.npmjs.com/package/ghostty-webgpu">npm</a>
        <a href="https://github.com/ShaulLavo/ghostty-webgpu/blob/main/docs/integration.md">Docs</a>
      </nav>
    </header>

    <main class="page">
      <section class="intro">
        <h1>An unofficial Ghostty for the web.</h1>
        <p class="lede">
          libghostty-vt compiled to WebAssembly, drawn by a damage-aware WebGPU renderer, behind a
          native API.
        </p>
        <div class="install">
          <code>npm install ghostty-webgpu</code>
          <button id="copy-install" type="button">Copy</button>
        </div>
      </section>

      <section class="window" id="window" data-ready="true" aria-label="Live terminal">
        <div class="chrome">
          <div class="window-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="backend" id="backend" title="Renderer in use on this device">HTML</span>
        </div>
        <div class="screen">
          <div id="terminal" role="img" aria-label="Animated Ghostty ghost">
            <div id="ghost-first-frame" set:html={firstFrame}></div>
          </div>
        </div>
      </section>
      <p id="wasm-unavailable" hidden>WebAssembly enables the live animation. This browser is showing its first frame.</p>
      <p class="stat" id="stat" aria-live="polite"></p>

      <section class="facts" aria-label="What makes it different">
        <p>
          <strong>Only what changed is drawn.</strong> The renderer tracks damage per cell, so an
          idle terminal costs nothing and a busy one costs only its busy rows.
        </p>
        <p>
          <strong>Falls back on its own.</strong> WebGPU first, then WebGL2, then Canvas2D, with the
          same output. This page is drawing with
          <span id="backend-fact">a renderer it is still choosing</span>.
        </p>
        <p>
          <strong>PTY traffic stays as bytes.</strong> The native API takes
          <code>Uint8Array</code> input and emits bytes for your PTY connection.
        </p>
      </section>
    </main>

    <footer class="colophon">
      <p>
        MIT licensed. Built on libghostty-vt. Not affiliated with the Ghostty project. The ghost
        animation is from <a href="https://github.com/ghostty-org/website">ghostty.org</a>, used
        under its MIT license. Still a preview, so expect gaps.
      </p>
    </footer>

    <script src="../main.ts"></script>
  </body>
</html>
