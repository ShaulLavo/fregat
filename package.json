  "scripts": {
    "bench:input:paired": "bun run --cwd packages/singapore/examples/stress bench:input:paired",
    "bench:large-file": "bun scripts/large-file/bench.ts",
    "build": "bun scripts/prod.ts build",
    "pair": "bun apps/server/src/devices/pair-command.ts",
    "usage:import-proxy-key": "bun scripts/import-proxy-usage-key.ts",
    "agent:browser": "bun scripts/agent/browser.ts",
    "agent:retention-count-policy": "bun scripts/agent/scenarios/editor-retention-count-policy-driver.ts",
    "logs": "bun scripts/agent/logs.ts",
    "logs:census": "bun scripts/lint/log-noise-census.ts --check",
    "dev": "bun --env-file=.env scripts/dev.ts",
    "dev:web": "bun --env-file=.env scripts/dev.ts --filter=!desktop",
    "dev:upstream": "bun --env-file=.env scripts/dev.ts --upstream --filter=!desktop",
    "dev:serve": "bun scripts/dev-serve.ts",
    "dev:unserve": "bun scripts/dev-serve.ts --remove",
    "dev:tui": "bun scripts/tui.ts",
    "desktop:dev": "bun --env-file=.env scripts/desktop-dev.ts",
    "lint": "bun run workspace:check && bun run plans:check && bun run --cwd packages/singapore lint:root && bun run dupes:functions && bun run dupes && bun run --parallel --no-exit-on-error --filter '*' lint",
    "design:census": "node scripts/lint/web-design-census.mjs --check",
    "compiler:census": "node scripts/lint/react-compiler-census.mjs --check",
    "errors:census": "node scripts/lint/error-context-census.mjs --check",
    "compiler:explain": "node scripts/lint/react-compiler-explain.mjs explain",
    "compiler:memos": "node scripts/lint/react-compiler-explain.mjs memos",
    "compiler:memos:check": "node scripts/lint/react-compiler-explain.mjs memos --check",
    "prod": "bun scripts/prod.ts",
    "bench:workspace-search": "bun apps/server/scripts/workspace-search-benchmark.ts",
    "start": "bun scripts/prod.ts start",
    "server:install": "bun scripts/install-server.ts",
    "format": "bun run format:root && bun run --cwd packages/singapore format:root && bun run --cwd packages/hotkeys format && bun run --filter '*' format",
    "format:check": "bun run format:check:root && bun run --cwd packages/singapore format:check:root && bun run --cwd packages/hotkeys format:check && bun run --filter '*' format:check",
    "typecheck": "bun run build:workspaces && bun run --sequential --filter '*' typecheck && bun run --cwd packages/hotkeys docs:check",
    "test": "bun run build:workspaces && bun run test:scripts && bun run --sequential --filter '*' test",
    "generated:check": "bun run workspace:check && bun run icons:generate:check && bun run settings:schema:check && bun run settings:reference:check && bun run themes:palette-css:check && bun run --cwd apps/server codex-protocol:check && bun run syntax:coverage:check && bun run native:workflow:check && bun run --cwd packages/ui tables:check",
    "native:workflow": "bun packages/ghostty-webgpu/scripts/config-resolver-native/generate-workspace-workflow.ts --write",
    "native:workflow:check": "bun packages/ghostty-webgpu/scripts/config-resolver-native/generate-workspace-workflow.ts --check",
    "settings:reference": "bun --tsconfig-override scripts/tsconfig.settings.json scripts/generate-settings-reference.ts",
    "settings:reference:check": "bun --tsconfig-override scripts/tsconfig.settings.json scripts/generate-settings-reference.ts --check",
    "settings:schema": "bun --tsconfig-override scripts/tsconfig.settings.json scripts/generate-settings-schema.ts",
    "settings:schema:check": "bun --tsconfig-override scripts/tsconfig.settings.json scripts/generate-settings-schema.ts --check",
    "app:mac": "bun apps/desktop/scripts/build-app.ts",
    "app-icon:generate": "bun scripts/app-icon/generate.ts",
    "icons:generate": "bun scripts/icons/generate.ts",
    "icons:generate:check": "bun scripts/icons/generate.ts --check",
    "themes:palette-css": "bun scripts/themes/generate-palette-css.ts",
    "themes:palette-css:check": "bun scripts/themes/generate-palette-css.ts --check",
    "standalone:consumer:check": "bun scripts/release/consumer-graph.mjs",
    "test:scripts": "bun --bun vitest run --config vitest.scripts.config.mjs",
    "verify": "bun run typecheck && bun run lint && bun run package-pages:check && bun run query:check && bun run arrays:check && bun run documents:check && bun run design:census && bun run compiler:census && bun run compiler:memos:check && bun run errors:census && bun run format:check && bun run generated:check && bun run unused:check && bun run test",
    "dupes": "jscpd apps packages scripts --threshold 0",
    "dupes:report": "jscpd apps packages scripts --reporters html,console --output ./jscpd-report",
    "unused:exports": "knip --exports --no-config-hints",
    "unused:files": "knip --files --no-config-hints",
    "unused:check": "knip",
    "hooks:install": "bun scripts/install-hooks.mjs",
    "hooks:pre-commit": "lefthook run pre-commit",
    "themes:import-omarchy": "bun scripts/themes/import-omarchy-theme.ts",
    "themes:omarchy-catalog": "bun scripts/themes/generate-omarchy-catalog.ts",
    "dupes:functions": "bun scripts/lint/duplicate-functions.mjs",
    "plans:check": "bun scripts/check-editor-backlog.mjs",
    "documents:inventory": "node scripts/document-consumer-inventory.mjs",
    "documents:check": "node scripts/lint/document-contributions.mjs",
    "package-pages:check": "bun scripts/check-package-pages.mjs",
    "gates": "bun run workspace:check && bun run package-pages:check && bun run plans:check && bun run dupes:functions && bun run dupes && bun run design:census && bun run compiler:census && bun run compiler:memos:check && bun run errors:census && bun run query:check && bun run arrays:check && bun run documents:check && bun run unused:check",
    "syntax:coverage": "bun apps/web/scripts/syntax-coverage.ts",
    "syntax:coverage:check": "bun apps/web/scripts/syntax-coverage.ts --check",
    "query:check": "node scripts/lint/query-api.mjs",
    "build:workspaces": "turbo run build --filter='./packages/singapore/packages/*' --filter=ghostty-webgpu --filter=ghostty-webgpu-line-editor --filter=ghostty-webgpu-shaders --filter='@fregat/*' --filter=@workspace/ui",
    "changeset": "node node_modules/@changesets/cli/bin.js",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun x turbo run build --filter=\"@singapore-editor/*\" --filter=\"@fregat/*\" --filter=ghostty-webgpu --filter=ghostty-webgpu-shaders && bun scripts/release/prepare.mjs && node node_modules/@changesets/cli/bin.js publish",
    "workspace:check": "bun scripts/workspace-tooling.mjs",
    "workspace:sync": "bun scripts/workspace-tooling.mjs --write",
    "format:root": "oxfmt --write .github *.json *.yml *.md .oxfmtrc.json .oxlintrc.json .jscpd.json",
    "format:check:root": "oxfmt --check .github *.json *.yml *.md .oxfmtrc.json .oxlintrc.json .jscpd.json",
    "install-release": "bun scripts/install-release.ts",
    "build-release": "bun scripts/build-release.ts",
    "arrays:check": "node scripts/lint/array-construction.mjs --full-types",
    "arrays:inventory": "node scripts/lint/array-construction.mjs --inventory --full-types",
    "test:t3code": "bun --bun vitest run --config vitest.t3code.config.mjs",
    "product-sites:deploy": "bun run --cwd scripts product-sites:deploy",
    "markdown:parity": "bun scripts/markdown/qualify.ts parity --baseline",
    "markdown:stream": "bun scripts/markdown/qualify.ts stream --baseline",
    "markdown:visual": "bun scripts/markdown/qualify.ts visual --baseline",
    "markdown:bench": "bun scripts/markdown/qualify.ts bench --baseline",
    "markdown:qualify": "bun scripts/markdown/qualify.ts qualify",
    "markdown:nightly": "bun scripts/markdown/qualify.ts --checks-only",
    "markdown:production:smoke": "bun scripts/markdown/production-browser.ts --smoke --trials 2 --warmups 1 --negative-controls",
    "markdown:production:retention": "bun scripts/markdown/production-resource-retention.ts",
    "markdown:check": "bun run --cwd packages/markdown test qualification-candidate && bun run --cwd apps/web test:markdown"
  },
