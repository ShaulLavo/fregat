{
  "name": "desktop",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:native && bun ../../scripts/run-with-env.ts bun src/launcher/index.ts --dev",
    "build": "bun run build:native",
    "build:native": "bun scripts/build-native.ts",
    "test": "bun --bun vitest run",
