{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:native && bun ../../scripts/run-with-env.ts PLATFORM_DESKTOP_SHARED_DEV=1 electrobun dev",
    "dev:standalone": "bun run build:native && bun ../../scripts/run-with-env.ts electrobun dev",
    "build": "bun run build:native && electrobun build",
    "build:native": "bun scripts/build-native.ts",
    "test": "bun --bun vitest run",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun scripts/ensure-devkit.ts && tsc --noEmit"
  },
  "dependencies": {
    "@workspace/contracts": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/utils": "workspace:*",
    "evlog": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "electrobun": "2.0.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "^7.0.2"
  }
}
