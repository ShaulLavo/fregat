{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    },
    "./client-contract": {
      "types": "./src/client-contract.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./testing/git-identity": {
      "types": "./src/testing/git-identity.ts",
      "default": "./src/testing/git-identity.ts"
    }
  },
  "scripts": {
    "dev": "bun ../../scripts/run-with-env.ts bun ../../scripts/restart-on-change.ts src/index.ts --watch src --watch ../../packages",
    "server": "bun --env-file=../../.env src/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env dist/index.js",
    "build": "tsc --noEmit && bun scripts/package-wallpapers.ts && bun build src/index.ts --target bun --outdir dist --external sharp --external @anthropic-ai/claude-agent-sdk && bun build src/provider/claude-discovery-worker.ts --target bun --outfile dist/claude-discovery-worker.ts --external @anthropic-ai/claude-agent-sdk && bun build src/fs/watch-worker.ts --target bun --outfile dist/watch-worker.ts && bun build src/installation/remote-support.ts --target bun --outfile dist/remote-support.js && bun build src/terminal-host/main.ts --target bun --outfile dist/pty-host.js",
    "prices:update": "bun scripts/update-model-prices.ts",
    "codex-protocol:check": "bun src/provider/adapters/codex-protocol/generate.ts --check",
    "codex-protocol:generate": "bun src/provider/adapters/codex-protocol/generate.ts",
    "test": "bun --bun vitest run",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@elysiajs/cors": "^1.4.2",
    "@modelcontextprotocol/server": "2.1.0",
    "@singapore-editor/lsp": "0.1.1",
    "@singapore-editor/typescript-lsp": "0.1.1",
    "@tanstack/pacer": "^0.22.0",
    "@tanstack/query-core": "^5.104.0",
    "@workspace/contracts": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/pty": "workspace:*",
    "@workspace/utils": "workspace:*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "evlog": "catalog:",
    "ignore": "^7.0.10",
    "jsonc-parser": "3.3.1",
    "jszip": "^3.10.2",
    "nanoid": "6.0.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "typescript-language-server": "6.0.1",
    "typescript-language-service": "npm:typescript@6.0.3",
    "valibot": "^1.5.0",
    "vscode-languageserver-protocol": "^3.18.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.3",
    "@types/subset-font": "^2.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.11.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "vitest": "catalog:",
    "vscode-langservers-extracted": "4.10.0"
  }
}
