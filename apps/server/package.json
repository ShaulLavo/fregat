{
  "name": "server",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    },
    "./client-contract": {
      "types": "./src/client-contract.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./testing/git-identity": {
      "types": "./src/testing/git-identity.ts",
      "default": "./src/testing/git-identity.ts"
    }
  },
  "scripts": {
    "dev": "bun ../../scripts/run-with-env.ts bun ../../scripts/restart-on-change.ts src/index.ts --watch src --watch ../../packages",
    "server": "bun --env-file=../../.env src/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env dist/index.js",
    "build": "tsc --noEmit && bun scripts/package-wallpapers.ts && bun build src/index.ts --target bun --outdir dist --external web-push --external @anthropic-ai/claude-agent-sdk && bun build src/provider/claude-discovery-worker.ts --target bun --outfile dist/claude-discovery-worker.ts --external @anthropic-ai/claude-agent-sdk && bun build src/fs/watch-worker.ts --target bun --outfile dist/watch-worker.ts && bun build src/installation/remote-support.ts --target bun --outfile dist/remote-support.js && bun build src/terminal-host/main.ts --target bun --outfile dist/pty-host.js && bun build src/themes/wallpapers/image-worker.ts --target bun --outfile dist/image-worker.ts && bun ../../scripts/licenses/server.ts",
    "prices:update": "bun scripts/update-model-prices.ts",
    "codex-protocol:check": "bun src/provider/adapters/codex-protocol/generate.ts --check",
    "codex-protocol:generate": "bun src/provider/adapters/codex-protocol/generate.ts",
    "codex-protocol:update": "bun src/provider/adapters/codex-protocol/update.ts",
    "test": "bun --bun vitest run",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@elysiajs/cors": "^1.4.2",
    "@modelcontextprotocol/server": "2.1.0",
    "@singapore-editor/lsp": "workspace:*",
    "@tanstack/query-core": "^5.104.0",
    "@valibot/to-json-schema": "1.8.0",
    "@workspace/contracts": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/pty": "workspace:*",
    "@workspace/push": "workspace:*",
    "@workspace/utils": "workspace:*",
    "diff": "9.0.0",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "evlog": "catalog:",
    "fflate": "^0.8.3",
    "ignore": "^7.0.10",
    "jsonc-parser": "3.3.1",
    "pngjs": "^7.0.0",
    "subset-font": "^2.9.0",
    "typescript": "7.0.2",
    "typescript-language-server": "6.0.1",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/bun": "catalog:",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/subset-font": "^2.3.0",
    "eslint": "^10.11.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript-language-service": "npm:typescript@6.0.3",
    "vitest": "catalog:",
    "vscode-langservers-extracted": "4.10.0"
  }
}
