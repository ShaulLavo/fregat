{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    },
    "./client-contract": {
      "types": "./src/client-contract.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "dev": "bun ../../scripts/run-with-env.ts --watch src/index.ts",
    "server": "bun --env-file=../../.env src/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env dist/index.js",
    "build": "tsgo --noEmit && bun scripts/package-wallpapers.ts && bun build src/index.ts --target bun --outdir dist --external sharp --external @anthropic-ai/claude-agent-sdk && bun build src/provider/claude-discovery-worker.ts --target bun --outfile dist/claude-discovery-worker.ts --external @anthropic-ai/claude-agent-sdk && bun build src/installation/remote-support.ts --target bun --outfile dist/remote-support.js",
    "prices:update": "bun scripts/update-model-prices.ts",
    "codex-protocol:check": "bun src/provider/adapters/codex-protocol/generate.ts --check",
    "codex-protocol:generate": "bun src/provider/adapters/codex-protocol/generate.ts",
    "test": "bun --bun vitest run",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@elysiajs/cors": "^1.4.2",
    "@singapore-editor/lsp": "0.1.1",
    "@singapore-editor/typescript-lsp": "0.1.1",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/query-core": "^5.102.8",
    "@workspace/contracts": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/pty": "workspace:*",
    "@workspace/utils": "workspace:*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "evlog": "catalog:",
    "ignore": "^7.0.9",
    "jsonc-parser": "3.3.1",
    "jszip": "^3.10.2",
    "nanoid": "3.3.18",
    "sharp": "^0.35.4",
    "subset-font": "^2.7.0",
    "typescript": "^7.0.2",
    "typescript-language-server": "6.0.0",
    "typescript-language-service": "npm:typescript@6.0.3",
    "valibot": "^1.5.0",
    "vscode-languageserver-protocol": "^3.18.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@types/bun": "1.3.14",
    "@types/node": "^25.9.6",
    "@types/subset-font": "^2.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.10.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.70.0",
    "vitest": "^4.1.11",
    "vscode-langservers-extracted": "4.10.0"
  }
}
