---
import '@fontsource-variable/inter/wght.css'
import '@fontsource-variable/jetbrains-mono/wght.css'
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import appIcon from '../../../web/public/icons/fregat.svg?url'
import Icons from '../components/Icons.astro'
import Plate from '../components/Plate.astro'
import { plateFor } from '../lib/bundles'
import '../styles/page.css'
import '../styles/replica.css'
import { version } from '../../../../package.json'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const repo = 'https://github.com/ShaulLavo/fregat'
const title = 'Fregat: the complete IDE in your browser, with your agents inside'
const description =
  'Fregat is a complete IDE that runs on your machine and opens in any browser: our own editor and terminal, language servers and git, with Claude Code and Codex on your own logins.'
const hero = await plateFor('tokyo-night')
const ogImage = new URL(`${base}og.jpg`, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hero.wallpaper} as="image" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={base}
          ><img src={appIcon} alt="" width="24" height="24" />Fregat</a
        >
        <nav>
          <a href="#review">Review</a><a href="#keeps-going">Work keeps going</a><a href="#agents"
            >Agents</a
          ><a href="#parts">Parts</a><a href={`${repo}#readme`}>Docs</a>
        </nav>
        <a class="cta sm sec" href={repo}
          ><svg aria-hidden="true"><use href="#i-gh"></use></svg>GitHub</a
        >
      </div>
    </header>

    <main class="wrap">
      <section class="hero">
        <h1>The complete IDE in your browser, with your agents inside.</h1>
        <p>
          Fregat runs on your machine and opens in any browser. Our own editor and terminal,
          language servers and git, with Claude Code and Codex on your own logins.
        </p>
        <div class="ctas">
          <a class="cta pri" href="#run">Run it from source</a>
          <a class="cta sec" href={repo}
            ><svg aria-hidden="true"><use href="#i-gh"></use></svg>View on GitHub</a
          >
        </div>
      </section>

      <figure style="margin:0">
        <Plate id="hero" bundle="tokyo-night" replica="fan-out" hero />
        <figcaption class="plate-cap">
          <span
            ><b>One prompt, three models.</b> Each works in its own git worktree; results arrive with
            their tests. Shown in the {hero.name} bundle: its palette, code theme, winding-road wallpaper
            and glass.</span
          >
          <button type="button" data-motion-for="hero" aria-controls="hero">Pause</button>
        </figcaption>
      </figure>

      <section class="sect" id="review">
        <div class="txt">
          <h2>Review agents like pull requests</h2>
          <p>
            Every turn is a checkpoint. Undo one hunk and keep the rest, batch line comments into
            one message, or ask a second model to review the change.
          </p>
        </div>
        <div>
          <Plate id="s-review" bundle="rose-pine" replica="review" />
          <div class="plate-cap">
            <span>Rosé Pine bundle, sunset-lake wallpaper.</span>
            <button type="button" data-motion-for="s-review" aria-controls="s-review">Pause</button>
          </div>
        </div>
      </section>

      <section class="sect flip" id="keeps-going">
        <div class="txt">
          <h2>Work keeps going</h2>
          <p>
            One server per machine serves every window and browser. Updates wait for running agent
            turns, check themselves live and roll back if the check fails. Terminals come back with
            their output.
          </p>
          <p class="fine">Terminal reattach after a restart ships on Linux; macOS is in progress.</p>
        </div>
        <div>
          <Plate id="s-update" bundle="sage" replica="update" />
          <div class="plate-cap">
            <span>Sage bundle, fern wallpaper.</span>
            <button type="button" data-motion-for="s-update" aria-controls="s-update">Pause</button>
          </div>
        </div>
      </section>

      <section class="sect" id="undo">
        <div class="txt">
          <h2>Nothing is lost</h2>
          <p>
            Undo in the file tree brings back a deleted folder with its open tabs and unsaved edits.
            The editor's history is a graph you can browse, and it survives closing the file.
          </p>
        </div>
        <div>
          <Plate id="s-undo" bundle="catppuccin" replica="undo" />
          <div class="plate-cap">
            <span>Catppuccin bundle, waves wallpaper.</span>
            <button type="button" data-motion-for="s-undo" aria-controls="s-undo">Pause</button>
          </div>
        </div>
      </section>

      <section class="sect flip" id="agents">
        <div class="txt">
          <h2>Bring your own agents</h2>
          <p>
            Claude Code and Codex run side by side on the logins you already have. Permission rules
            are saved as real rules in each tool, and every chat shows its usage, limits and cost.
          </p>
        </div>
        <div>
          <Plate id="s-agents" bundle="graphite" replica="agents" />
          <div class="plate-cap">
            <span>Graphite bundle, layers wallpaper.</span>
            <button type="button" data-motion-for="s-agents" aria-controls="s-agents">Pause</button>
          </div>
        </div>
      </section>

      <section class="parts" id="parts">
        <div>
          <h2>Built from our own parts</h2>
          <p>
            Each one is a library with its own site and benchmarks, so you can check the numbers on
            your machine.
          </p>
        </div>
        <ul>
          <li>
            <b>Singapore</b>
            <p>
              The editor. Files up to 200 MiB stay editable; parsing and the TypeScript language
              service run in workers.
            </p>
            <a href="https://shaulavo.dev/singapore/">Site and benchmarks</a>
          </li>
          <li>
            <b>ghostty-webgpu</b>
            <p>
              The terminal. Ghostty's own core compiled to WebAssembly, with four renderers that
              redraw only changed cells.
            </p>
            <a href="https://shaulavo.dev/ghostty-webgpu/">Site and benchmarks</a>
          </li>
          <li>
            <b>hotkeys</b>
            <p>
              The keymap. Bindings follow focus, you can override or remove any binding a pack
              adds, and one keymap drives the browser and the terminal.
            </p>
            <a href="https://github.com/ShaulLavo/hotkeys">Docs</a>
          </li>
        </ul>
      </section>

      <section class="runit" id="run">
        <h2>Run it on your machine.</h2>
        <div class="term">
          <div><span class="p">$ </span>git clone {repo} &amp;&amp; cd fregat</div>
          <div><span class="p">$ </span>bun install</div>
          <div><span class="p">$ </span>bun run dev</div>
        </div>
        <p class="fine">Linux and macOS. Needs Bun and Git. No account.</p>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <a class="brand" href={base}
          ><img src={appIcon} alt="" width="20" height="20" />Fregat</a
        >
        <span>{version} · MIT licensed. Made by Shaul Lavochkin.</span>
        <nav>
          <a href={repo}>GitHub</a><a href={`${repo}#readme`}>Docs</a><a
            href={`${repo}/blob/main/PLAN.md`}>Roadmap</a
          ><a href={`${repo}/blob/main/apps/site/ATTRIBUTIONS.md`}>Image credits</a><a
            href={`${repo}/blob/main/LICENSE`}>License</a
          >
        </nav>
      </div>
    </footer>

    <Icons />
    <script>
      import '../scripts/player.ts'
    </script>
  </body>
</html>
