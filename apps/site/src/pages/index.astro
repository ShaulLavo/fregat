---
import { Image } from 'astro:assets'
import Drawing from '../components/Drawing.astro'
import wallpaper from '../assets/eyes-wide.jpg'
import workbench from '../assets/workbench.webp'
import '../styles/global.css'

const title = 'fregat'
const description =
  'cursor, built right, from scratch. chat first, with the whole editor in the same window, across every project on every machine. bring claude code or codex on the subscription you already have.'
const demoUrl = import.meta.env.DEV
  ? 'http://localhost:5173/demo.html'
  : `${import.meta.env.BASE_URL.replace(/\/$/, '')}/demo/index.html`

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(workbench.src, Astro.site)} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <a class="wordmark" href={import.meta.env.BASE_URL}>
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="26" cy="16" r="5" />
            <circle cx="21" cy="24.7" r="5" />
            <circle cx="11" cy="24.7" r="5" />
            <circle cx="6" cy="16" r="5" />
            <circle cx="11" cy="7.3" r="5" />
            <circle cx="21" cy="7.3" r="5" />
          </g>
        </svg>
        fregat<small>Фрегат</small>
      </a>
      <nav>
        <a href="#window">one window</a>
        <a href="#parts">what's inside</a>
        <a href="#next">on the way</a>
        <a href="#agents">agents</a>
        <a href="#name">the name</a>
        <a href="#try">try it</a>
        <a class="button small" href="https://github.com/ShaulLavo/fregat">github</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <h1 id="hero-heading">cursor, built right, from scratch</h1>
          <p>
            chat first, with diffs, search and the full editor in the same window. every project,
            on every machine, one keystroke apart. bring the agent you already pay for.
          </p>
          <div class="actions">
            <a class="button" href="https://github.com/ShaulLavo/fregat">get the source</a>
            <a class="button ghost" href="#try">run it locally</a>
            <span class="status">desktop app available from source; no public downloads yet</span>
          </div>
        </div>
        <figure class="shot">
          <div class="product-stage">
            <Image
              class="wallpaper"
              src={wallpaper}
              alt=""
              loading="eager"
              width={1600}
              widths={[800, 1600, 2400]}
              sizes="(min-width: 1440px) 1440px, 100vw"
              quality={85}
            />
            <div class="workbench" id="demo-frame" aria-busy="true" data-demo-url={demoUrl}>
              <iframe
                id="workbench-demo"
                title="Interactive fregat demo with simulated files, terminal and agents"
                width="1360"
                height="840"
                allow="fullscreen"
              ></iframe>
            </div>
          </div>
          <figcaption class="statusbar">
            <span>interactive demo. simulated workspace, terminal and agents</span>
            <div class="demo-actions">
              <span id="demo-status" role="status">loading demo…</span>
              <button type="button" id="demo-reset" aria-controls="workbench-demo">reset</button>
              <a href={demoUrl} target="_blank" rel="noopener">open full size</a>
              <a href={wallpaper.src}>wallpaper</a>
            </div>
          </figcaption>
        </figure>
      </section>

      <div class="wrap panes">
        <section class="pane" id="window" aria-labelledby="window-heading">
          <div class="bar"><span>one window</span></div>
          <div class="pane-body">
            <h2 id="window-heading">the chat and the editor are one app</h2>
            <p>
              fregat puts the conversation first and keeps the editor inside it: open the
              diff an agent just wrote, search the workspace, jump to a definition, run it in the
              terminal, and land back in the chat where you left it.
            </p>
            <p>
              every workspace sits in one sidebar, whether it lives on your laptop, a desktop at
              home or a server you ssh into. run agents in five projects on three machines and
              move between them the way you move between tabs.
            </p>
          </div>
        </section>

        <section class="pane" id="parts" aria-labelledby="parts-heading">
          <div class="bar"><span>what's inside</span><span class="count">6</span></div>
          <div class="pane-body">
            <h2 id="parts-heading">built from our own parts</h2>
            <dl class="parts">
              <div>
                <dt>editor</dt>
                <dd>
                  <a href="https://github.com/ShaulLavo/singapore">singapore</a>, our own editor,
                  written from the text buffer up, with language servers for completions and
                  diagnostics.
                </dd>
              </div>
              <div>
                <dt>parsing</dt>
                <dd>
                  <a href="https://github.com/ShaulLavo/tree-sitter-x">tree-sitter-x</a>, our fork
                  of tree-sitter. built without emscripten, it keeps the text inside the parser and
                  reparses edits incrementally.
                </dd>
              </div>
              <div>
                <dt>terminal</dt>
                <dd>
                  <a href="https://github.com/ShaulLavo/ghostty-webgpu">ghostty-webgpu</a>, real
                  ghostty compiled to wasm and drawn on the gpu, in a pane next to the code.
                </dd>
              </div>
              <div>
                <dt>git</dt>
                <dd>status, diffs, branches and commits in the same window, watched live.</dd>
              </div>
              <div>
                <dt>yours to tune</dt>
                <dd>
                  themes, fonts, keybindings, density, and a setting for nearly everything else.
                </dd>
              </div>
              <div>
                <dt>anywhere</dt>
                <dd>
                  a small server runs on each machine. every workspace opens from a browser, the
                  desktop app on macos and linux, or a terminal. a phone browser connects through
                  an https proxy on your tailnet after device pairing.
                </dd>
              </div>
            </dl>
          </div>
        </section>

        <section class="pane" id="next" aria-labelledby="next-heading">
          <div class="bar"><span>on the way</span><span class="count">3</span></div>
          <div class="pane-body">
            <h2 id="next-heading">what we're building now</h2>
            <dl class="parts">
              <div>
                <dt>markdown</dt>
                <dd>
                  <a href="https://github.com/ShaulLavo/tree-sitter-md">tree-sitter-md</a>, our
                  parser in c, already passes all 676 commonmark and gfm examples. next it renders
                  the agent's streaming replies, powers the chat composer, and opens any .md file as
                  source, side by side with a preview, or as one live view you edit as it renders.
                </dd>
              </div>
              <div>
                <dt>mcp</dt>
                <dd>
                  fregat already runs its own mcp server, and agents can read the workspace
                  through it today. next: every action in the app, and the editor's types and
                  references, so an agent sees the code the way you do.
                </dd>
              </div>
              <div>
                <dt>github</dt>
                <dd>pull requests, reviews and checks, next to the diff they're about.</dd>
              </div>
            </dl>
          </div>
        </section>

        <section class="pane" id="agents" aria-labelledby="agents-heading">
          <div class="bar"><span>agents</span><span class="count">2</span></div>
          <div class="pane-body">
            <h2 id="agents-heading">bring your own harness</h2>
            <div class="sessions" aria-hidden="true">
              <div class="session">
                <div class="bar"><span>claude code</span><span class="mode">approval required</span></div>
                <ol>
                  <li><b>&gt;</b> move the settings registry into contracts</li>
                  <li>reading packages/contracts/src/settings/keys.ts</li>
                  <li><i>edit</i> keys.ts, 3 changes. allow?</li>
                </ol>
              </div>
              <div class="session">
                <div class="bar"><span>codex</span><span class="mode">full access</span></div>
                <ol>
                  <li><b>&gt;</b> why does the tree typecheck fail on a clean checkout</li>
                  <li>running bun run --filter @workspace/tree typecheck</li>
                  <li><i>found</i> zustand declared, never installed</li>
                </ol>
              </div>
            </div>
            <p>
              fregat runs claude code and codex. sign in from inside the app against your own
              account and run several sessions side by side.
            </p>
          </div>
        </section>

        <section class="pane" id="why" aria-labelledby="where-heading">
          <div class="bar"><span>why from scratch</span></div>
          <div class="pane-body">
            <h2 id="where-heading">owning every layer is what makes it smooth</h2>
            <p>
              fregat owns the editor, the terminal, the tree and the shell around them, so an
              agent is a pane the same way the
              terminal is, and a diff opens in the chat without a context switch.
            </p>
            <p>
              owning these parts lets us tune the editor, terminal and workspace together.
            </p>
          </div>
        </section>

        <section class="pane" id="name" aria-labelledby="name-heading">
          <div class="bar"><span>the name</span><span class="mode">фрегат</span></div>
          <div class="pane-body name">
            <div>
              <h2 id="name-heading">why fregat</h2>
              <p>
                фрегат is the upper stage that rides on top of a soyuz. the rocket gets it out of
                the atmosphere, then it flies the rest on its own: its own engine, its own
                guidance, restarting as many times as the orbit needs, dropping each payload where
                it belongs. it has done that for more than three hundred of them.
              </p>
              <p>
                that is the shape of this editor. the machine underneath is yours, the agents are
                yours, and the stage in between is small, autonomous and built to be restarted.
                the stage comes from the lavochkin bureau, which is also where the author's name
                comes from.
              </p>
            </div>
            <div class="aside">
              <figure class="drawing">
                <Drawing />
                <figcaption>
                  <b>fig. 1</b> the stage from above (a) and from the side (b). six tanks in a
                  ring, one engine, dimensions in millimetres.
                </figcaption>
              </figure>
              <dl class="spec">
                <div><dt>built by</dt><dd>npo lavochkin, khimki</dd></div>
                <div><dt>first flight</dt><dd>february 2000</dd></div>
                <div><dt>tanks</dt><dd>6, in a ring</dd></div>
                <div><dt>engine</dt><dd>s5.92, 19.85 kn</dd></div>
                <div><dt>restarts</dt><dd>up to 7</dd></div>
                <div><dt>diameter</dt><dd>3 440 mm</dd></div>
                <div><dt>height</dt><dd>1 875 mm</dd></div>
                <div><dt>payloads flown</dt><dd>300 and counting</dd></div>
              </dl>
            </div>
          </div>
        </section>

        <section class="pane" id="try" aria-labelledby="try-heading">
          <div class="bar"><span>try it</span></div>
          <div class="pane-body">
            <h2 id="try-heading">clone it and run it</h2>
            <ul class="prereqs">
              <li><b>bun</b>, and at least one of</li>
              <li><b>claude code</b>: <code>claude auth login</code>, or sign in from the app</li>
              <li><b>codex</b>: install the cli, then <code>codex login</code></li>
            </ul>
            <div class="terminal">
              <div class="bar"><span>terminal</span><span class="mode">bash</span></div>
              <pre><code>git clone https://github.com/ShaulLavo/fregat
<span class="c"># singapore and ghostty-webgpu are included in this repo</span>
cd fregat
bun install
bun run dev
<span class="c"># open the url it prints, pick a folder</span></code></pre>
            </div>
          </div>
        </section>
      </div>
    </main>

    <footer class="foot">
      <dl class="block">
        <div>
          <dt>name</dt>
          <dd><a href="https://github.com/ShaulLavo/fregat">fregat</a></dd>
        </div>
        <div>
          <dt>editor</dt>
          <dd><a href="https://github.com/ShaulLavo/singapore">singapore</a></dd>
        </div>
        <div>
          <dt>terminal</dt>
          <dd><a href="https://github.com/ShaulLavo/ghostty-webgpu">ghostty-webgpu</a></dd>
        </div>
        <div>
          <dt>revision</dt>
          <dd>source builds; public downloads pending</dd>
        </div>
        <div>
          <dt>made by</dt>
          <dd>shaul lavochkin</dd>
        </div>
      </dl>
    </footer>
  </body>
</html>

<script>


  function setupDemo() {
    const frame = document.querySelector<HTMLElement>('#demo-frame')
    const iframe = document.querySelector<HTMLIFrameElement>('#workbench-demo')
    const reset = document.querySelector<HTMLButtonElement>('#demo-reset')
    const status = document.querySelector<HTMLElement>('#demo-status')
    if (!frame || !iframe || !reset || !status || !frame.dataset.demoUrl) return

    const demoUrl = new URL(frame.dataset.demoUrl, window.location.href)
    demoUrl.searchParams.set('parentOrigin', window.location.origin)
    const resize = new ResizeObserver(([entry]) => {
      if (entry) frame.style.setProperty('--demo-scale', String(entry.contentRect.width / 1360))
    })
    resize.observe(frame)
    frame.style.setProperty('--demo-scale', String(frame.clientWidth / 1360))

    window.addEventListener('message', (event: MessageEvent<unknown>) => {
      if (event.source !== iframe.contentWindow || event.origin !== demoUrl.origin) return
      const message = event.data
      if (!message || typeof message !== 'object' || !('type' in message)) return
      if (message.type === 'fregat-demo-error') {
        status.textContent = "the demo couldn't load. try reset."
        return
      }
      if (message.type !== 'fregat-demo-ready') return
      frame.setAttribute('aria-busy', 'false')
      status.textContent = 'ready to explore'
    })
    reset.addEventListener('click', () => {
      frame.setAttribute('aria-busy', 'true')
      status.textContent = 'resetting demo…'
      iframe.src = demoUrl.href
    })
    iframe.src = demoUrl.href
  }

  setupDemo()
</script>
