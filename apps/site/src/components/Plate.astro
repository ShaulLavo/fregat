---
import { plateFor } from '../lib/bundles'
import { replicaHtml, type ReplicaName } from '../lib/replica'

type Props = {
  id: string
  bundle: string
  replica: ReplicaName
  hero?: boolean
}

const { id, bundle, replica, hero = false } = Astro.props
const plate = await plateFor(bundle)
---

<div class:list={['plate', { 'hero-plate': hero }]} style={plate.style}>
  <img
    class="wallpaper"
    src={plate.wallpaper}
    width={plate.wallpaperWidth}
    height={plate.wallpaperHeight}
    loading={hero ? 'eager' : 'lazy'}
    fetchpriority={hero ? 'high' : 'auto'}
    alt=""
  />
  <div class="stage" id={id} data-replica>
    <Fragment set:html={replicaHtml(replica)} />
  </div>
</div>
