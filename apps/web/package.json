{
  "name": "web",
  "version": "0.0.34",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:vite dev:types",
    "build": "bun run typecheck && bun --bun --env-file=../../.env vite build",
    "bundle:report": "bun scripts/bundle-report.ts",
    "bundle:gate": "bun scripts/bundle-gate.ts",
    "proof:workspace-reload": "bun scripts/workspace-reload-proof.mjs --check",
    "bench:editor-open": "bun scripts/editor-open-benchmark.mjs",
    "bench:editor-open:calibrate": "bun scripts/calibrate-editor-open-benchmark.mjs",
    "bench:editor-open:gate": "bun scripts/editor-open-benchmark.mjs --gate --browsers=chromium",
    "bench:editor-open:gate:all": "bun scripts/editor-open-benchmark.mjs --gate --browsers=chromium,webkit,firefox",
    "bench:editor-scroll": "bun scripts/editor-scroll-benchmark.mjs",
    "bench:editor-scroll:gate": "bun scripts/editor-scroll-benchmark.mjs --gate --browsers=chromium",
    "bench:editor-scroll:gate:all": "bun scripts/editor-scroll-benchmark.mjs --gate --browsers=chromium,webkit,firefox",
    "bench:editor-scroll:huge": "node scripts/generate-bench-fixture.mjs && bun scripts/editor-scroll-benchmark.mjs --file=.bench-fixtures/huge.ts --start-fraction=0.5 --page-timeout-ms=180000 --app-url=http://localhost:3000/",
    "bench:editor-typing": "bun scripts/editor-typing-benchmark.mjs",
    "bench:editor-typing:gate": "bun scripts/editor-typing-benchmark.mjs --gate --browsers=chromium",
    "bench:editor-typing:gate:all": "bun scripts/editor-typing-benchmark.mjs --gate --browsers=chromium,webkit,firefox",
    "bench:editor-typing:huge": "node scripts/generate-bench-fixture.mjs && bun scripts/editor-typing-benchmark.mjs --file=.bench-fixtures/huge.ts --start-fraction=0.5 --page-timeout-ms=180000 --app-url=http://localhost:3000/",
    "bench:file-tree-prepared-input": "bun scripts/file-tree-prepared-input-benchmark.ts",
    "bench:file-tree-prepared-input:gate": "bun scripts/file-tree-prepared-input-benchmark.ts --gate",
    "bench:fixture": "node scripts/generate-bench-fixture.mjs",
    "start": "bun --bun --env-file=../../.env vite preview",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun --bun vitest run --project node --project dom",
    "test:watch": "bun --bun vitest --project node --project dom",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:syntax-settings-browser": "vitest run --config vitest.syntax-settings-browser.config.ts",
    "test:retention-reload-browser": "vitest run --config retention-acceptance.vitest.config.ts",
    "test:retention-layout-browser": "vitest run --config retention-acceptance-layout.vitest.config.ts",
    "test:tree-browser": "vitest run --config vitest.tree-browser.config.ts",
    "test:durations": "bun --bun vitest run --project node --project dom --reporter=json --outputFile=node_modules/.cache/shard-durations-report.json && bun scripts/shard-durations.ts node_modules/.cache/shard-durations-report.json",
    "typecheck": "bun ../../scripts/check-dev-types.ts",
    "preview": "bun --bun --env-file=../../.env vite preview",
    "dev:vite": "bun ../../scripts/run-with-env.ts vite",
    "dev:types": "bun ../../scripts/check-dev-types.ts --watch",
    "typecheck:dev": "bun ../../scripts/check-dev-types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elysia/eden": "^1.4.10",
    "@fregat/hotkeys": "catalog:",
    "@lexical/react": "^0.51.0",
    "@lexical/text": "^0.51.0",
    "@phosphor-icons/react": "^2.1.10",
    "@singapore-editor/core": "workspace:*",
    "@singapore-editor/decode": "workspace:*",
    "@singapore-editor/diff": "workspace:*",
    "@singapore-editor/find": "workspace:*",
    "@singapore-editor/gutters": "workspace:*",
    "@singapore-editor/highlighting": "workspace:*",
    "@singapore-editor/lsp": "workspace:*",
    "@singapore-editor/lsp-plugin": "workspace:*",
    "@singapore-editor/markdown": "workspace:*",
    "@singapore-editor/minimap": "workspace:*",
    "@singapore-editor/paged": "workspace:*",
    "@singapore-editor/plugin-ui": "workspace:*",
    "@singapore-editor/react": "workspace:*",
    "@singapore-editor/scope-lines": "workspace:*",
    "@singapore-editor/spellcheck": "workspace:*",
    "@singapore-editor/textbuffer": "workspace:*",
    "@singapore-editor/tree-sitter": "workspace:*",
    "@singapore-editor/tree-sitter-languages": "workspace:*",
    "@tanstack/query-core": "^5.104.0",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@workspace/client-core": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/markdown": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/tree": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "evlog": "catalog:",
    "ghostty-webgpu": "workspace:*",
    "js.foresight": "^4.2.1",
    "lexical": "^0.51.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^12.0.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "server": "workspace:*",
    "shiki": "4.4.3",
    "sonner": "^2.0.8",
    "uqr": "0.1.3",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/history": "1.162.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "catalog:",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "catalog:",
    "happy-dom": "^20.14.5",
    "msw": "^2.15.0",
    "oxc-transform-react": "^0.151.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vscode-json-languageservice": "6.0.0-next.3"
  }
}
