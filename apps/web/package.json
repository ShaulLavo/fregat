{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:vite dev:types",
    "build": "tsgo --build && bun --env-file=../../.env vite build",
    "bundle:report": "bun scripts/bundle-report.ts",
    "proof:workspace-reload": "bun scripts/workspace-reload-proof.mjs --check",
    "bench:editor-open": "bun scripts/editor-open-benchmark.mjs",
    "bench:editor-open:calibrate": "bun scripts/calibrate-editor-open-benchmark.mjs",
    "bench:editor-open:gate": "bun scripts/editor-open-benchmark.mjs --gate --browsers=chromium",
    "bench:editor-open:gate:all": "bun scripts/editor-open-benchmark.mjs --gate --browsers=chromium,webkit,firefox",
    "bench:editor-scroll": "bun scripts/editor-scroll-benchmark.mjs",
    "bench:editor-scroll:gate": "bun scripts/editor-scroll-benchmark.mjs --gate --browsers=chromium",
    "bench:editor-scroll:gate:all": "bun scripts/editor-scroll-benchmark.mjs --gate --browsers=chromium,webkit,firefox",
    "bench:editor-scroll:huge": "node scripts/generate-bench-fixture.mjs && bun scripts/editor-scroll-benchmark.mjs --file=.bench-fixtures/huge.ts --start-fraction=0.5 --page-timeout-ms=180000 --app-url=http://localhost:3000/",
    "bench:editor-typing": "bun scripts/editor-typing-benchmark.mjs",
    "bench:editor-typing:gate": "bun scripts/editor-typing-benchmark.mjs --gate --browsers=chromium",
    "bench:editor-typing:gate:all": "bun scripts/editor-typing-benchmark.mjs --gate --browsers=chromium,webkit,firefox",
    "bench:editor-typing:huge": "node scripts/generate-bench-fixture.mjs && bun scripts/editor-typing-benchmark.mjs --file=.bench-fixtures/huge.ts --start-fraction=0.5 --page-timeout-ms=180000 --app-url=http://localhost:3000/",
    "bench:file-tree-prepared-input": "bun scripts/file-tree-prepared-input-benchmark.ts",
    "bench:file-tree-prepared-input:gate": "bun scripts/file-tree-prepared-input-benchmark.ts --gate",
    "bench:fixture": "node scripts/generate-bench-fixture.mjs",
    "start": "bun --env-file=../../.env vite preview",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun --bun vitest run --project node --project dom",
    "test:watch": "bun --bun vitest --project node --project dom",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsgo --build",
    "preview": "bun --env-file=../../.env vite preview",
    "dev:vite": "bun ../../scripts/run-with-env.ts vite",
    "dev:types": "bun ../../scripts/check-dev-types.ts --watch",
    "typecheck:dev": "bun ../../scripts/check-dev-types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elysia/eden": "^1.4.10",
    "@foresightjs/react": "^1.0.0",
    "@lexical/react": "^0.45.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/langs": "4.4.3",
    "@singapore-editor/core": "0.1.2",
    "@singapore-editor/decode": "0.1.0",
    "@singapore-editor/diff": "0.2.0",
    "@singapore-editor/find": "0.1.1",
    "@singapore-editor/gutters": "0.1.1",
    "@singapore-editor/lsp": "0.1.1",
    "@singapore-editor/lsp-plugin": "0.1.1",
    "@singapore-editor/markdown": "0.1.0",
    "@singapore-editor/minimap": "0.1.1",
    "@singapore-editor/plugin-ui": "0.1.0",
    "@singapore-editor/react": "0.1.1",
    "@singapore-editor/scope-lines": "0.1.1",
    "@singapore-editor/textbuffer": "0.1.0",
    "@singapore-editor/tree-sitter": "0.1.1",
    "@singapore-editor/tree-sitter-languages": "0.1.1",
    "@singapore-editor/typescript-lsp": "0.1.1",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@workspace/client-core": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/markdown": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/tree": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "evlog": "catalog:",
    "ghostty-webgpu": "0.1.2",
    "js.foresight": "^4.2.1",
    "lexical": "^0.45.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^11.16.1",
    "react": "^19.3.0",
    "react-animated-counter": "^1.9.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "server": "workspace:*",
    "shiki": "4.4.3",
    "sonner": "^2.0.8",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/history": "1.162.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.3.14",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "happy-dom": "^20.14.5",
    "msw": "^2.15.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.70.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vscode-json-languageservice": "5.7.2"
  }
}
