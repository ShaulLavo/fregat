{
  "name": "tui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.tsx",
    "build": "tsgo --noEmit && bun build src/main.tsx --target bun --outdir dist --packages external",
    "typecheck": "tsgo --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@opentui/core": "catalog:",
    "@opentui/react": "catalog:",
    "@singapore-editor/core": "0.1.2",
    "@singapore-editor/diff": "0.2.0",
    "@singapore-editor/lsp": "0.1.1",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/query-core": "^5.102.8",
    "@workspace/client-core": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/tree": "workspace:*",
    "@workspace/utils": "workspace:*",
    "evlog": "catalog:",
    "react": "^19.3.0",
    "shiki": "4.4.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.70.0",
    "server": "workspace:*",
    "vitest": "catalog:"
  }
}
