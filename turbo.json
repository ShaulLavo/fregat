{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "VITE_SERVER_URL", "VITE_BASE_PATH"],
  "globalPassThroughEnv": [
    "FS_DEV_MAX_TEXT_FILE_BYTES",
    "FS_HOST",
    "FS_METADATA_DB",
    "FS_SYSTEM_ROOT",
    "FS_TREE_CONCURRENCY",
    "FS_WATCH",
    "FS_WORKSPACE_ROOT",
    "HOST",
    "OBSERVABILITY_BATCH_INTERVAL_MS",
    "OBSERVABILITY_BATCH_SIZE",
    "OBSERVABILITY_CONSOLE",
    "OBSERVABILITY_DIR",
    "OBSERVABILITY_ENABLED",
    "OBSERVABILITY_FILE_PRETTY",
    "OBSERVABILITY_INFO_SAMPLE_RATE",
    "OBSERVABILITY_MAX_BUFFER_SIZE",
    "OBSERVABILITY_MAX_FILES",
    "OBSERVABILITY_MAX_SIZE_BYTES",
    "OBSERVABILITY_POSTHOG_API_KEY",
    "OBSERVABILITY_POSTHOG_DISTINCT_ID",
    "OBSERVABILITY_POSTHOG_ENABLED",
    "OBSERVABILITY_POSTHOG_EVENT_NAME",
    "OBSERVABILITY_POSTHOG_HOST",
    "OBSERVABILITY_POSTHOG_MODE",
    "OBSERVABILITY_POSTHOG_RETRIES",
    "OBSERVABILITY_POSTHOG_TIMEOUT_MS",
    "OBSERVABILITY_SERVICE",
    "OBSERVABILITY_SLOW_MS",
    "PLATFORM_HOME",
    "PLATFORM_SETTINGS_POLICY",
    "PORT",
    "POSTHOG_API_KEY",
    "POSTHOG_HOST",
    "SERVER_ALLOWED_ORIGINS",
    "WEB_HOST",
    "WEB_PORT"
  ],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "ghostty-webgpu-site#build": {
      "dependsOn": ["^build", "ghostty-webgpu#build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"],
      "cache": false
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@singapore-editor/core#typecheck": {
      "dependsOn": [
        "build",
        "@singapore-editor/decode#build",
        "@singapore-editor/diff#build",
        "@singapore-editor/find#build",
        "@singapore-editor/gutters#build",
        "@singapore-editor/markdown#build",
        "@singapore-editor/scope-lines#build",
        "@singapore-editor/tree-sitter-languages#build"
      ]
    },
    "@singapore-editor/react#typecheck": {
      "dependsOn": ["^build", "build", "@singapore-editor/tree-sitter-languages#build"]
    },
    "@singapore-editor/tree-sitter#typecheck": {
      "dependsOn": [
        "^build",
        "build",
        "@singapore-editor/markdown#build",
        "@singapore-editor/tree-sitter-languages#build"
      ]
    },
    "@singapore-editor/core#test": {
      "dependsOn": [
        "build",
        "@singapore-editor/tree-sitter-languages#build",
        "@singapore-editor/diff#build",
        "@singapore-editor/gutters#build"
      ],
      "cache": false
    },
    "@singapore-editor/react#test": {
      "dependsOn": ["^build", "build", "@singapore-editor/tree-sitter-languages#build"]
    },
    "@singapore-editor/tree-sitter#test": {
      "dependsOn": [
        "^build",
        "build",
        "@singapore-editor/markdown#build",
        "@singapore-editor/tree-sitter-languages#build"
      ]
    },
    "@singapore-editor/markdown#typecheck": {
      "dependsOn": ["^build", "build", "@singapore-editor/tree-sitter-languages#build"]
    },
    "@singapore-editor/markdown#test": {
      "dependsOn": ["^build", "build", "@singapore-editor/tree-sitter-languages#build"]
    },
    "@singapore-editor/stress#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/editor/docs/performance/e034-*.json.gz"]
    }
  },
  "agentGuidance": false,
  "globalDependencies": [
    ".oxfmtrc.json",
    ".oxlintrc.json",
    "tsconfig.json",
    "patches/**",
    "hotkeys/tsconfig.json",
    "hotkeys/.oxfmtrc.json",
    "hotkeys/.oxlintrc.json",
    "ghostty-webgpu/.oxlintrc.json",
    "editor/.oxlintrc.json",
    "editor/scripts/build-package.ts",
    "editor/tsconfig.json",
    "editor/global.d.ts",
    "editor/examples/app/tsconfig.json",
    "editor/scripts/workspace-root*"
  ]
}
