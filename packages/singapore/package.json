{
  "name": "editor-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "site"
    ],
    "catalog": {
      "@fregat/hotkeys": "https://github.com/ShaulLavo/hotkeys/releases/download/hotkeys-3de9d21e2299d2b94ed2d8b012c25bf9358dcfbd/fregat-hotkeys-3de9d21e2299d2b94ed2d8b012c25bf9358dcfbd.tgz",
      "@types/bun": "1.4.2",
      "vite": "8.3.1"
    }
  },
  "type": "module",
  "scripts": {
    "bench:input:paired": "bun run --cwd examples/stress bench:input:paired",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "bun run lint:root && turbo lint",
    "format": "bun run format:root && turbo format",
    "format:check": "bun run format:check:root && turbo format:check",
    "health": "bun run check:full-text && bun scripts/command-reference.ts --check && bun scripts/architecture-health.mjs",
    "commands:reference": "bun scripts/command-reference.ts",
    "tree-sitter-x:update": "bun scripts/update-tree-sitter-x.ts",
    "check:full-text": "bun scripts/check-full-text-boundary.mjs --self-test && bun scripts/check-full-text-boundary.mjs",
    "health:write": "bun scripts/architecture-health.mjs --write",
    "publish:packages": "bun scripts/publish-packages.ts",
    "publish:packages:dry-run": "bun scripts/publish-packages.ts --dry-run",
    "test": "turbo test",
    "stress:build": "turbo build --filter=@singapore-editor/core --filter=@singapore-editor/file-animation --filter=@singapore-editor/find --filter=@singapore-editor/lsp --filter=@singapore-editor/markdown --filter=@singapore-editor/minimap --filter=@singapore-editor/scope-lines --filter=@singapore-editor/tree-sitter-languages --filter=@singapore-editor/paged",
    "bench:stress": "bun run stress:build && bun run --cwd examples/stress bench",
    "bench:input": "bun run stress:build && bun run --cwd examples/stress bench:input",
    "lint:root": "oxlint --disable-nested-config scripts knip.ts",
    "format:root": "oxfmt --write .",
    "format:check:root": "oxfmt --check ."
  },
  "devDependencies": {
    "knip": "6.38.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "2.11.5",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vite": "8.3.1"
  },
  "overrides": {
    "web-tree-sitter": "github:ShaulLavo/tree-sitter-x#d4c988a02313fef32a307f8f254ab7a1dba18515"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "vitest@5.0.2": "patches/vitest@5.0.2.patch",
    "@vitest/mocker@5.0.2": "patches/@vitest%2Fmocker@5.0.2.patch",
    "@vitest/browser-playwright@5.0.2": "patches/@vitest%2Fbrowser-playwright@5.0.2.patch"
  }
}
