{
  "name": "@workspace/tree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/style.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/utils/model/FileTreeController.ts"
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --project node --project dom",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "evlog": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/browser-playwright": "^4.1.8",
    "happy-dom": "^20.10.3",
    "oxfmt": "0.64.0",
    "oxlint": "1.70.0",
    "playwright": "^1.59.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
