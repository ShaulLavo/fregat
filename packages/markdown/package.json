{
  "name": "@workspace/markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./providers/*": "./src/providers/*.ts",
    "./state/*": "./src/state/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project node --project dom"
  },
  "dependencies": {
    "@singapore-editor/highlighting": "workspace:*",
    "@tanstack/query-core": "^5.104.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast-util-to-hast": "^13.2.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remend": "^1.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/bun": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
