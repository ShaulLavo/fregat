{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@typescript/native-preview"],
  "workspaces": {
    "apps/desktop": {
      "entry": ["src/bun/index.ts", "src/preload/index.ts", "electrobun.config.ts"]
    },
    "apps/server": {
      "entry": [
        "src/provider/claude-discovery-worker.ts",
        "scripts/pty-benchmark.ts",
        "scripts/pty-smoke.ts",
        "scripts/workspace-search-benchmark.ts",
        "test/openssh-scenario.ts",
        "test/service-openssh-scenario.ts",
        "src/fs/tests/contracts.test-d.ts"
      ],
      "ignoreDependencies": ["eslint", "vscode-langservers-extracted"]
    },
    "apps/web": {
      "entry": [
        "src/features/address/tests/navigation.types.ts",
        "scripts/chat-parity-proof.mjs",
        "scripts/chat-review-proof.mjs",
        "scripts/chat-review-proof-entry.mjs",
        "scripts/chat-scroll-proof.mjs",
        "scripts/chat-scroll-proof-entry.mjs",
        "scripts/chat-snapshot-benchmark.ts",
        "scripts/keymap-baseline.mjs",
        "scripts/verify-federated-environments.mjs",
        "scripts/verify-web-design.mjs",
        "scripts/verify-workspace-navigation.mjs",
        "test/factories/chat-proof-workspace.tsx"
      ],
      "ignoreFiles": ["test/fixtures/workbench-file-server/repo/src/editor-tab-{a,b,c}.ts"],
      "ignoreUnresolved": ["src/index.ts"]
    },
    "packages/contracts": {
      "ignoreUnresolved": ["scripts/generate-settings-schema.ts"]
    },
    "scripts": {
      "entry": [
        "desktop-dev.ts",
        "dev.ts",
        "generate-settings-reference.ts",
        "generate-settings-schema.ts",
        "install-server.ts",
        "prod.ts",
        "tui.ts",
        "web-layering.mjs",
        "lint/web-boundaries.mjs"
      ]
    },
    ".": {
      "ignoreDependencies": ["turbo"]
    },
    "apps/tui": {
      "entry": [
        "src/search/tests/replacement.test-d.ts",
        "test/processes/job-control-launcher.ts",
        "test/processes/job-control-session.ts",
        "test/processes/storage-writer.ts"
      ]
    },
    "packages/pty": {
      "entry": ["test/nvim-smoke.ts", "test/fixtures/child.ts"]
    }
  }
}
